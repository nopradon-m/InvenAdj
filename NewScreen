              ClearCollect(colExcel, Blank()); // ล้าง colExcel เพื่อเตรียมเก็บข้อมูลใหม่

              ForAll(
                  textItems,
                  If(
                      Len(ThisRecord.Value) > 0, // ตรวจสอบว่า Row นี้ไม่ว่างเปล่า
                      Collect(
                          colExcel,
                          {
                              Brand: First(Split(ThisRecord.Value, Char(9))).Value, // แยกคอลัมน์แรก
                              MPN: Last(FirstN(Split(ThisRecord.Value, Char(9)), 2)).Value, // แยกคอลัมน์ที่สอง
